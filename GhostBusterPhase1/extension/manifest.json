{
  "manifest_version": 3,
  "name": "GhostBuster",
  "version": "1.0.0",
  "description": "Capture bugs with screenshot + DOM + voice, analyze with Gemini, auto-fix with the GhostBuster agent.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle GhostBuster capture"
    }
  },
  "action": {
    "default_title": "GhostBuster — Click or ⌘⇧G to toggle capture"
  }
}
